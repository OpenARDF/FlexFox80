* text=auto

# Repository policy files
/.gitattributes text eol=lf
/.gitignore text eol=lf
/.editorconfig text eol=lf
/Justfile text eol=lf

# Hand-maintained source, documentation, and web/event assets
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.dox text eol=lf
*.rst text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.ino text eol=lf
*.S text eol=lf

# KiCad and manufacturing text formats
*.sch text eol=lf
*.pro text eol=lf
*.net text eol=lf
*.lib text eol=lf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_pro text eol=lf
*.kicad_prl text eol=lf
*.kicad_sym text eol=lf
